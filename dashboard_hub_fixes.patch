diff --git a/tests/test_pipelines_ui.py b/tests/test_pipelines_ui.py
index 7875efb..f7e7cbf 100644
--- a/tests/test_pipelines_ui.py
+++ b/tests/test_pipelines_ui.py
@@ -272,3 +272,89 @@ def test_agent_filter_is_limited_to_the_selected_pipeline():
     at = AppTest.from_function(_results_wf_app, default_timeout=30).run()
     at.selectbox(key="dr_wf").select("1.json").run()
     assert list(at.multiselect(key="dr_agents_1.json").options) == ["metafora"]
+
+
+def _run_panel_app(pid="batch", state=None, log_key=None, log=None):
+    import streamlit as st
+
+    from reii.pipelines.hub_tab import HubContext, _run_panel
+
+    ss = st.session_state
+    ss[{"batch": "batch_worker_state", "workflow": "workflow_state",
+        "discourse": "discourse_state"}[pid]] = state
+    if log_key and log is not None:
+        ss[log_key] = log
+    ctx = HubContext(
+        get_status=lambda: {},
+        session=ss,
+        get_effective_config=lambda: {},
+        config_categories={},
+        save_config=lambda u: {},
+        reset_config=None,
+        start_workflow=lambda p: None,
+        list_workflows=lambda: [],
+        rename_workflow=lambda f, n: None,
+        start_discourse=lambda *a: None,
+        run_fix=lambda fid: "",
+    )
+    _run_panel(ctx, pid)
+
+
+def test_run_panel_does_not_show_false_error_for_batch_without_exit_code():
+    # batch_worker_state solo trae running/paused/finished — nunca "exit_code".
+    # Antes, _run_panel asumía exit_code == 0 para éxito y mostraba un error
+    # falso ("código None") en todo lote que terminara bien.
+    at = AppTest.from_function(
+        _run_panel_app,
+        kwargs={"pid": "batch", "state": {"running": False, "finished": True, "paused": False}},
+        default_timeout=30,
+    ).run()
+    assert not at.exception, at.exception
+    assert len(at.error) == 0
+    assert any("sin errores" in s.value for s in at.success)
+
+
+def test_run_panel_still_reports_real_errors_for_workflow():
+    at = AppTest.from_function(
+        _run_panel_app,
+        kwargs={"pid": "workflow", "state": {"running": False, "finished": True, "exit_code": -1}},
+        default_timeout=30,
+    ).run()
+    assert not at.exception, at.exception
+    assert len(at.success) == 0
+    assert any("terminó con error" in s.value for s in at.error)
+
+
+def test_run_panel_reads_the_registered_log_key_not_a_guessed_one():
+    at = AppTest.from_function(
+        _run_panel_app,
+        kwargs={
+            "pid": "workflow", "state": {"running": True, "finished": False},
+            "log_key": "workflow_log", "log": ["linea 1"],
+        },
+        default_timeout=30,
+    ).run()
+    assert not at.exception, at.exception
+    assert any("linea 1" in c.value for c in at.code)
+
+
+def test_discourse_options_reach_the_per_workflow_run_with_non_default_values():
+    # Antes estas opciones se leían pero nunca se usaban: el pipeline siempre
+    # corría con force=False, source="db", sin importar lo elegido aquí.
+    at = AppTest.from_function(_hub_app, default_timeout=30).run()
+    at.tabs[2].radio(key="hub_dc_source").set_value("json").run()
+    at.tabs[2].checkbox(key="hub_dc_force").set_value(True).run()
+    at.tabs[2].text_input(key="hub_dc_label").set_value("corrida-x").run()
+    at.tabs[2].button(key="hub_wfrun_1.json").click().run()
+    kind, args = [c for c in at.session_state["calls"] if c[0] == "discourse"][0]
+    assert args == ("1.json", True, "corrida-x", True, "json")
+
+
+def test_discourse_options_are_published_to_session_for_the_agents_crud():
+    # dashboard.py lee st.session_state["hub_discourse_options"] para que los
+    # botones de ejecutar agentes (dentro de ctx.render_agents_crud) usen las
+    # mismas opciones en vez de valores fijos.
+    at = AppTest.from_function(_hub_app, default_timeout=30).run()
+    at.tabs[2].checkbox(key="hub_dc_force").set_value(True).run()
+    opts = at.session_state["hub_discourse_options"]
+    assert opts == {"store": True, "force": True, "label": None, "source": "db"}

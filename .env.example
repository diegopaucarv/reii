# ============================================================
# REII — Environment configuration template
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Filesystem paths ──────────────────────────────────────────────────
REII_ROOT_DIR=.
REII_DATA_DIR=data/input
REII_OUTPUT_DIR=output
REII_MODELS_DIR=models

# ── spaCy / NLP models ────────────────────────────────────────────────
REII_SPACY_MODEL=es_core_news_lg
REII_SENTENCE_EMBEDDER_MODEL=BAAI/bge-m3
REII_GLINER_MODEL=urchade/gliner_multi-v2.1
REII_GPT2_MODEL=datificate/gpt2-small-spanish

# ── Embedding / segmenter models ──────────────────────────────────────
REII_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
REII_SEGMENTER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REII_NLI_MODEL=facebook/bart-large-mnli

# ── LLM ───────────────────────────────────────────────────────────────
REII_LLM_MODEL=deepseek-chat

# ── Stanza ────────────────────────────────────────────────────────────
REII_STANZA_LANG=es
REII_STANZA_USE_GPU=false

# ── Adverb classifier ─────────────────────────────────────────────────
REII_ADVERB_CLASSIFIER_DIR=models/adverb_model

# ── Database / persistence ────────────────────────────────────────────
REII_DB_PATH=data/analisis_gramatical.json
REII_WORKFLOW_DB_PATH=data/workflow_data.json
REII_BEST_PARAMS_PATH=data/best_params.json
REII_DISCOURSE_STATE_PATH=data/discourse_state.json

# ── IA agent configs ──────────────────────────────────────────────────
REII_GRAMMAR_CONFIG_PATH=ia/0.json
REII_DISCOURSE_CONFIG_PATH=ia/1.json

# ── SUPTLEX-ESP (leave empty to skip) ─────────────────────────────────
# REII_SUBTLEX_PATH=data/SUBTLEX-ESP.xlsx

# ── Word embeddings FastText (leave empty to skip) ─────────────────────
# REII_WORD_EMBEDDINGS_PATH=data/cc.es.300.bin

# ── Pipeline toggles ──────────────────────────────────────────────────
REII_USE_COREF=true
REII_USE_SUBTLEX=true
REII_USE_WORDNET_QUANTIFIERS=true
REII_USE_GENSIM_EMBEDDINGS=true

# ── API keys / tokens ─────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
HF_TOKEN=hf-your-token-here

# ── Corpus metadata ───────────────────────────────────────────────────
REII_CORPUS_NAME=Corpus ALCESTE

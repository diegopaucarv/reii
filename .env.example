# ============================================================
# REII — Environment configuration template
# Copy this to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# ── Filesystem paths ──────────────────────────────────────────────────
REII_ROOT_DIR=.
REII_DATA_DIR=data/input
REII_OUTPUT_DIR=output
REII_MODELS_DIR=models

# ── spaCy / NLP models ────────────────────────────────────────────────
REII_SPACY_MODEL=es_core_news_lg
REII_SENTENCE_EMBEDDER_MODEL=BAAI/bge-m3
REII_GLINER_MODEL=urchade/gliner_multi-v2.1
REII_GPT2_MODEL=datificate/gpt2-small-spanish

# ── Embedding / segmenter models ──────────────────────────────────────
REII_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
REII_SEGMENTER_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REII_NLI_MODEL=facebook/bart-large-mnli

# ── LLM ───────────────────────────────────────────────────────────────
REII_LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
REII_LLM_FALLBACK_MODEL=Prism-ML/Ternary-Bonsai-27B
REII_LLM_MAX_RETRIES=5

# ── Stanza ────────────────────────────────────────────────────────────
REII_STANZA_LANG=es
REII_STANZA_USE_GPU=false

# ── Stanza remoto (servidor FastAPI en Colab) ─────────────────────────
# Si STANZA_SERVER_URL está definido, los sujetos raíz de COREF se piden
# por HTTP a este servidor en vez de ejecutar Stanza localmente (más rápido
# si no tienes GPU local). Deja STANZA_SERVER_URL vacío para usar Stanza local.
STANZA_SERVER_URL=
STANZA_SERVER_TOKEN=
STANZA_SERVER_TIMEOUT=120
STANZA_SERVER_FALLBACK_LOCAL=true

# ── COREF: sujetos raíz y ventanas por lote ───────────────────────────
# Para volver al comportamiento anterior (coref completo, una llamada por
# texto): REII_ROOTS_SKIP_COREF=false REII_ROOTS_BATCH_SIZE=0
REII_ROOTS_SKIP_COREF=true
REII_ROOTS_BATCH_SIZE=32
# Ventanas de coref por lote en _extract_global_chains (bulk_process).
# <=1: sin lotes. Para documentos grandes se encoge automáticamente (evita OOM).
REII_COREF_BATCH_SIZE=16

# ── Stanza remoto (servidor FastAPI en Colab) ─────────────────────────
# Si STANZA_SERVER_URL está definido, los sujetos raíz de la etapa
# COREF se piden por HTTP al servidor (p. ej. Colab) en vez de ejecutar
# Stanza localmente. Deja la URL vacía para usar Stanza local.
#   STANZA_SERVER_URL=https://xxxx.trycloudflare.com
#   STANZA_SERVER_TOKEN=<token del notebook de Colab>
STANZA_SERVER_URL=
STANZA_SERVER_TOKEN=
STANZA_SERVER_TIMEOUT=120
STANZA_SERVER_FALLBACK_LOCAL=true

# ── COREF: sujetos raíz y ventanas por lote ──────────────────────────
# Sujetos raíz por UCE: sin coref (basta depparse+constituency) y por lotes.
# Para volver al comportamiento anterior: REII_ROOTS_SKIP_COREF=false REII_ROOTS_BATCH_SIZE=0
REII_ROOTS_SKIP_COREF=true
REII_ROOTS_BATCH_SIZE=32
# Ventanas de coref por lote en la extracción de cadenas globales (bulk_process).
# <=1: sin lotes (una ventana por llamada, comportamiento anterior).
REII_COREF_BATCH_SIZE=16

# ── Adverb classifier ─────────────────────────────────────────────────
REII_ADVERB_CLASSIFIER_DIR=models/adverb_model

# ── Database / persistence ────────────────────────────────────────────
REII_DB_PATH=data/analisis_gramatical.json
REII_WORKFLOW_DB_PATH=data/workflow_data.json
REII_BATCH_DB_PATH=data/entrevistas.json
REII_TRANSCRIPTS_DIR=data/entrevistas
REII_BEST_PARAMS_PATH=data/best_params.json
REII_DISCOURSE_STATE_PATH=data/discourse_state.json

# ── IA agent configs ──────────────────────────────────────────────────
REII_GRAMMAR_CONFIG_PATH=ia/0.json
REII_DISCOURSE_CONFIG_PATH=ia/1.json

# ── SUPTLEX-ESP (leave empty to skip) ─────────────────────────────────
REII_SUBTLEX_PATH= "D:\SUBTLEX-ESP.xlsx"
# ── Word embeddings FastText (leave empty to skip) ─────────────────────
REII_WORD_EMBEDDINGS_PATH="D:\cc.es.300.bin"

# ── Pipeline toggles ──────────────────────────────────────────────────
REII_USE_COREF=true
REII_USE_SUBTLEX=true
REII_USE_WORDNET_QUANTIFIERS=true
REII_USE_GENSIM_EMBEDDINGS=true

# ── API keys / tokens ─────────────────────────────────────────────────
# Together AI (OpenAI-compatible). Copia este archivo a `.env` y
# rellena la clave real.
TOGETHER_API_KEY=tgp_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TOGETHER_API_URL=https://api.together.ai/v1/chat/completions
HF_TOKEN=hf-your-token-here

# ── Corpus metadata ───────────────────────────────────────────────────
REII_CORPUS_NAME=Corpus ALCESTE

+def is_sign_flip(r1, r2):
+    """Signos opuestos y |ρ| ≥ umbral en AMBAS etapas."""
+    return (
+        r1 is not None
+        and r2 is not None
+        and r1 * r2 < 0
+        and abs(r1) >= SIGNFLIP_MIN_ABS_RHO
+        and abs(r2) >= SIGNFLIP_MIN_ABS_RHO
+    )
+

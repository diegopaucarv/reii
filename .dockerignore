# ── Python artifacts ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ────────────────────────────────────────────
.venv/
venv/
env/

# ── Output files (generated) ────────────────────────────────────────
output/
global_dashboard.json
global_lexical.json
global_lexical.xlsx
red_semantica.gexf
history_log.txt
data/*.json
*.ipynb_checkpoints/

# ── Logs & temp ─────────────────────────────────────────────────────
*.log
history_log.txt

# ── IDE / Editor ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Jupyter ─────────────────────────────────────────────────────────
notebooks/.ipynb_checkpoints/

# ── Git (if present) ────────────────────────────────────────────────
.git/
.gitignore

# ── Environment files (keep secrets out of images) ──────────────────
.env
.env.local
.env.*.local

# ── Docker build allow-list ───────────────────────────────────────────
# The project filesystem has generated entries Docker cannot stat. The image
# only needs these files; runtime data and models are mounted by Compose.
*
!Dockerfile
!requirements.txt
!pyproject.toml
!src/
!src/**
